{
  "name": "sociolod",
  "version": "1.0.1",
  "description": "TypeScript SDK for YouTube and Spotify APIs. Search videos and tracks, retrieve media metadata and thumbnails, and request MP3/MP4 download URLs or streams in Node.js, browsers, and edge runtimes.",
  "keywords": [
    "sociolod",
    "youtube",
    "youtube-api",
    "youtube-search",
    "youtube-downloader",
    "youtube-mp3",
    "spotify",
    "spotify-api",
    "spotify-search",
    "spotify-downloader",
    "media-api",
    "media-downloader",
    "typescript",
    "typescript-sdk",
    "sdk",
    "nodejs",
    "javascript",
    "browser",
    "edge",
    "discord-bot"
  ],
  "homepage": "https://github.com/Peculiar-010/sociolod#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peculiar-010/sociolod.git"
  },
  "bugs": {
    "url": "https://github.com/Peculiar-010/sociolod/issues"
  },
  "author": "sparclac@gmail.com",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./youtube": {
      "import": "./dist/youtube/index.js",
      "require": "./dist/youtube/index.cjs",
      "types": "./dist/youtube/index.d.ts"
    },
    "./spotify": {
      "import": "./dist/spotify/index.js",
      "require": "./dist/spotify/index.cjs",
      "types": "./dist/spotify/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "lint": "eslint src tests examples --ext .ts",
    "lint:fix": "eslint src tests examples --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "msw": "^3.0.4",
    "prettier": "^3.2.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Peculiar-010"
  }
}
